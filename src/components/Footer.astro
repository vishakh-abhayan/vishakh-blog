---
const year = new Date().getFullYear();
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="footer-name">Vishakh Abhayan</p>
      <p>Notes on building thoughtful things with code and AI.</p>
    </div>
    <div class="footer-links">
      <a href="https://github.com/Vishakh-abhayan" rel="me">GitHub</a>
      <a href={`${base}rss.xml`}>RSS feed</a>
    </div>
    <p class="copyright">© {year} Vishakh Abhayan</p>
  </div>
</footer>
