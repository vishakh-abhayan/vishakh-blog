---
import { getPublishedPosts } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getPublishedPosts();
const groups = Map.groupBy(posts, (post) => post.data.publishedAt.getFullYear());
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title="Archive — What If We Stop Asking Whether AI Thinks?" description="All essays and short posts by Vishakh Abhayan.">
  <article class="archive-page">
    <div class="narrow">
      <h1>Archive</h1>
      <p class="archive-intro">All essays and short posts, newest first.</p>

      {[...groups.entries()].map(([year, yearPosts]) => (
        <section class="archive-year">
          <h2>{year}</h2>
          <ul class="link-list archive-list">
            {yearPosts.map((post) => (
              <li>
                <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
                <span>({post.data.type === 'essay' ? 'Essay' : 'Short post'})</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </article>
</BaseLayout>
