---
import { render } from 'astro:content';
import { getPublishedPosts, formatDate } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title={`${post.data.title} — Vishakh Abhayan`} description={post.data.description}>
  <article class="post-page">
    <div class="narrow">
      <a class="back-link" href={`${base}blog/`}>← Back to all writing</a>
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        <p class="post-date"><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time></p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <footer class="post-footer">
        <a href={`${base}blog/`}>Back to archive</a>
      </footer>
    </div>
  </article>
</BaseLayout>
