---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title="About — What If We Stop Asking Whether AI Thinks?" description="About Vishakh Abhayan and this personal blog.">
  <article class="simple-page">
    <div class="narrow prose">
      <h1>About</h1>
      <p>Vishakh Abhayan explores local AI, code, visual experiments, and practical automation.</p>
      <p>This site is a working notebook for clear explanations, useful discoveries, and honest accounts of building things.</p>
      <p><a href={`${base}blog/`}>Browse the archive</a> or visit <a href="https://github.com/Vishakh-abhayan">GitHub</a>.</p>
    </div>
  </article>
</BaseLayout>
