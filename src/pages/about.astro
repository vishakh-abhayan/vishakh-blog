---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout title="About — Vishakh Abhayan" description="About Vishakh Abhayan and this personal blog.">
  <section class="about shell">
    <div class="about-title">
      <p class="eyebrow">About</p>
      <h1>I like making ideas tangible.</h1>
    </div>
    <div class="about-copy">
      <p class="lead">I’m Vishakh Abhayan. I explore local AI, code, visual experiments, and practical automation.</p>
      <p>This site is a working notebook: a place for clear explanations, useful discoveries, and honest accounts of what it takes to build something.</p>
      <p>I am especially interested in tools that keep people close to their work—fast enough to invite play, simple enough to understand, and open enough to change.</p>
      <div class="about-links">
        <a class="button button-primary" href={`${base}blog/`}>Browse the writing</a>
        <a class="text-link" href="https://github.com/Vishakh-abhayan">Find me on GitHub ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
