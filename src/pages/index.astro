---
import { getPublishedPosts } from '../lib/posts';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getPublishedPosts();
const essays = posts.filter((post) => post.data.type === 'essay');
const shortPosts = posts.filter((post) => post.data.type === 'short');
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout>
  <article class="home-page">
    <div class="narrow">
      <section class="bio">
        <p>
          Vishakh Abhayan is a builder exploring local AI, creative tools, and practical automation. He writes about making useful things with code and understanding the systems behind them<span class="more-punctuation">… </span><button class="more-button" type="button" aria-expanded="false" aria-controls="more-bio">More</button>
        </p>
        <div id="more-bio" class="more-bio" hidden>
          <p>His current interests include private AI workflows, small 3D and web experiments, and ways people can collaborate with capable software without losing control of their work.</p>
          <p>This site is a public notebook for essays, short observations, and lessons from building.</p>
        </div>
      </section>

      {essays.length > 0 && (
        <section class="link-section">
          <h2>Essays</h2>
          <ul class="link-list">
            {essays.map((post) => (
              <li><a href={`${base}blog/${post.id}/`}>{post.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      {shortPosts.length > 0 && (
        <section class="link-section">
          <h2>Short posts</h2>
          <ul class="link-list">
            {shortPosts.map((post) => (
              <li><a href={`${base}blog/${post.id}/`}>{post.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      <section class="link-section">
        <h2>Elsewhere</h2>
        <ul class="link-list annotated-list">
          <li><a href="https://github.com/Vishakh-abhayan" rel="me">GitHub</a><span>(projects)</span></li>
          <li><a href={`${base}rss.xml`}>RSS</a><span>(updates)</span></li>
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  const button = document.querySelector('.more-button');
  const content = document.querySelector('.more-bio');
  const punctuation = document.querySelector('.more-punctuation');
  button?.addEventListener('click', () => {
    const willOpen = content?.hasAttribute('hidden');
    content?.toggleAttribute('hidden');
    punctuation?.toggleAttribute('hidden');
    button.textContent = willOpen ? 'Less' : 'More';
    button.setAttribute('aria-expanded', String(willOpen));
  });
</script>
