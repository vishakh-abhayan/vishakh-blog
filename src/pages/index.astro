---
import { getPublishedPosts, formatDate } from '../lib/posts';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getPublishedPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const morePosts = posts.filter((post) => post.id !== featured?.id).slice(0, 3);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Vishakh Abhayan · Personal blog</p>
      <h1>Thoughts on building with AI, code, and curiosity.</h1>
      <p class="hero-intro">
        Practical notes from experiments with local models, creative tools, and the small systems that help ideas become real.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={`${base}blog/`}>Read the writing <span aria-hidden="true">→</span></a>
        <a class="text-link" href={`${base}about/`}>A little about me</a>
      </div>
    </div>
    <aside class="hero-note" aria-label="Topics covered">
      <p class="mono-label">CURRENTLY EXPLORING</p>
      <ul>
        <li><span>01</span> Local-first AI workflows</li>
        <li><span>02</span> Small tools with real utility</li>
        <li><span>03</span> Creative coding experiments</li>
      </ul>
      <div class="orbit" aria-hidden="true"><i></i><b></b></div>
    </aside>
  </section>

  {featured && (
    <section class="featured-wrap">
      <div class="shell featured-grid">
        <div class="section-heading">
          <p class="eyebrow">Featured note</p>
          <p>A considered place to begin.</p>
        </div>
        <article class="featured-post">
          <div class="post-meta">
            <time datetime={featured.data.publishedAt.toISOString()}>{formatDate(featured.data.publishedAt)}</time>
            <span>{featured.data.tags[0]}</span>
          </div>
          <h2><a href={`${base}blog/${featured.id}/`}>{featured.data.title}</a></h2>
          <p>{featured.data.description}</p>
          <a class="read-link" href={`${base}blog/${featured.id}/`}>Read note <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </section>
  )}

  <section class="shell latest-section">
    <div class="section-bar">
      <div>
        <p class="eyebrow">From the notebook</p>
        <h2>Latest writing</h2>
      </div>
      <a class="text-link" href={`${base}blog/`}>View all</a>
    </div>
    {morePosts.length > 0 ? (
      <div class="post-list">
        {morePosts.map((post) => (
          <article class="post-row">
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
            <div>
              <h3><a href={`${base}blog/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </div>
            <span aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    ) : (
      <div class="quiet-note">
        <p>More notes are taking shape.</p>
        <span>New essays and experiments will appear here.</span>
      </div>
    )}
  </section>
</BaseLayout>
